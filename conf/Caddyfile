{
    http_port 8080
	https_port 8443
}

{$OSU_API_PROXY_SERVER_NAME} {

    handle / {
        respond 200
    }

    @osu path /api/* /oauth/token
    handle @osu {
        route {
            map {http.request.header.X-Proxy-Secret} {key_ok} {
                "~^({$OSU_API_PROXY_KEYS})$" 1
                default 0
            }

            @denied vars {key_ok} 0
            respond @denied 403

            rate_limit {
                zone api {
                    key static
                    events 60
                    window 1m
                }
            }

            reverse_proxy https://osu.ppy.sh {
                header_up Host {upstream_hostport}
                header_up -X-Proxy-Secret
            }
        }
    }

    handle {
        respond 404
    }
}